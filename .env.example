# Copy this file to .env before starting Docker Compose. Do not commit .env.
MYSQL_DATABASE=community
MYSQL_USER=community
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# At least 64 random characters. Example: openssl rand -base64 48
JWT_SECRET=generate-a-unique-random-secret-with-at-least-64-characters

# The only public port exposed by the stack.
HTTP_PORT=80

